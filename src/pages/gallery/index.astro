---
import { getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SplitText from '../../components/SplitText.astro';
import ContactSheet from '../../components/ContactSheet.astro';
import { getAlbums } from '../../lib/gallery';
import { formatDate } from '../../lib/writing';

const albums = await getAlbums();
const intro = await getEntry('sections', 'gallery');
const { Content } = intro ? await render(intro) : { Content: null };
const total = albums.reduce((n, a) => n + a.photos.length, 0);
---

<Base title="Gallery" description={intro?.data.lede}>
  <section class="wrap page-head">
    <p class="eyebrow" data-reveal="fade">{albums.length} albums · {total} photographs</p>
    <h1><SplitText text={intro?.data.title ?? 'Gallery'} /></h1>
    {intro?.data.lede && <p class="lede" data-reveal="blur" style="--i:4">{intro.data.lede}</p>}
    {Content && <div class="intro prose" data-reveal style="--i:5"><Content /></div>}
  </section>

  <section class="wrap" aria-label="Contact sheet">
    {albums.length > 0 ? <ContactSheet albums={albums} /> : <p class="muted">No albums yet.</p>}
  </section>

  {
    albums.length > 0 && (
      <section class="wrap index" aria-label="Album index">
        <p class="eyebrow" data-reveal="fade">Index</p>
        <ol class="rows">
          {albums.map((a, i) => (
            <li data-reveal style={`--i:${i % 6}`}>
              <a href={`/gallery/${a.slug}/`} class="row glow-card">
                <span class="r-num">{a.frame}</span>
                <span class="r-title">{a.title}</span>
                <span class="r-meta">
                  {a.date && <span>{formatDate(a.date, 'short')}</span>}
                  <span>{a.photos.length} photos</span>
                  <span class:list={['stock', a.mode]}>{a.mode === 'bw' ? 'B&W' : 'Colour'}</span>
                  {a.favorite && <span class="fav" title="Favourite">●</span>}
                </span>
              </a>
            </li>
          ))}
        </ol>
      </section>
    )
  }
</Base>

<style>
  .intro {
    margin-top: 1rem;
    color: var(--muted);
  }

  .index {
    margin-top: clamp(3rem, 7vw, 5rem);
  }

  .rows {
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line-soft);
  }

  .row {
    display: grid;
    grid-template-columns: 3.2rem 1fr auto;
    align-items: baseline;
    gap: 1rem;
    padding: 1rem 0.8rem;
    border-bottom: 1px solid var(--line-soft);
    text-decoration: none;
    transition: background 0.4s, box-shadow 0.6s var(--ease-out);
  }

  .row:hover {
    background: color-mix(in srgb, var(--olive) 40%, transparent);
    color: inherit;
  }

  .r-num {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--cognac);
  }

  .r-title {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 1rem + 0.8vw, 1.6rem);
  }

  .r-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.3rem 1rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .stock.color {
    color: var(--film-edge-color);
  }

  .stock.bw {
    color: var(--film-edge-bw);
  }

  .fav {
    color: var(--grease-red);
  }

  @media (max-width: 600px) {
    .row {
      grid-template-columns: 2.4rem 1fr;
    }

    .r-meta {
      grid-column: 2;
      justify-content: flex-start;
    }
  }
</style>
