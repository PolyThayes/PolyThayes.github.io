---
import Base from '../../layouts/Base.astro';
import PhotoGrid from '../../components/PhotoGrid.astro';
import { getAlbums, type Album } from '../../lib/gallery';
import { formatDate } from '../../lib/writing';
import { marked } from '../../lib/markdown';

export async function getStaticPaths() {
  const albums = await getAlbums();
  return albums.map((album, i) => ({
    params: { album: album.slug },
    props: {
      album,
      prev: albums[i - 1] as Album | undefined,
      next: albums[i + 1] as Album | undefined,
    },
  }));
}

const { album, prev, next } = Astro.props;
const bodyHtml = album.body ? marked(album.body) : '';
const photos = album.photos.map((p) => ({ ...p, albumTitle: album.title }));
const stock = album.mode === 'bw' ? 'HP5+ · Black & white' : 'Portra 400 · Colour';
---

<Base title={album.title} description={album.description}>
  <section class="wrap head">
    <a href="/gallery/" class="back" data-reveal="fade">← Contact sheet</a>
    <p class="eyebrow" data-reveal="fade" style="--i:1">
      Frame {album.frame} · {album.photos.length} photographs{album.date && <> · {formatDate(album.date)}</>}
    </p>
    <h1 data-reveal="blur" style="--i:2">{album.title}</h1>
    {album.location && <p class="loc" data-reveal="fade" style="--i:3">{album.location}</p>}
    <p class:list={['stock', album.mode]} data-reveal="fade" style="--i:3">{stock}</p>

    <div class="about" data-reveal style="--i:4">
      {album.description && <p class="lede">{album.description}</p>}
      {bodyHtml && <div class="prose muted" set:html={bodyHtml} />}
    </div>

    <div class="actions" data-reveal style="--i:5">
      <button class="btn btn--solid" type="button" data-open-lightbox>
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M7 5v14l11-7z" /></svg>
        View full-screen
      </button>
      {
        album.albumUrl && (
          <a class="btn" href={album.albumUrl} target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4v11m0 0-4.5-4.5M12 15l4.5-4.5M5 19h14" /></svg>
            Download full album
          </a>
        )
      }
    </div>
  </section>

  <section class="wrap">
    <PhotoGrid photos={photos} />
  </section>

  <nav class="wrap pager" aria-label="More albums">
    {prev ? <a href={`/gallery/${prev.slug}/`} class="glow-card">← {prev.title}</a> : <span />}
    <a href="/gallery/" class="glow-card center">Back to the contact sheet</a>
    {next ? <a href={`/gallery/${next.slug}/`} class="glow-card end">{next.title} →</a> : <span />}
  </nav>
</Base>

<script>
  import '../../scripts/lightbox';
</script>

<style>
  .head {
    padding-block: clamp(2.5rem, 7vw, 5rem) 2.5rem;
  }

  .back {
    display: inline-block;
    margin-bottom: 2rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--cream-dim);
  }

  h1 {
    margin-top: 0.8rem;
    font-size: clamp(2.6rem, 1.6rem + 5vw, 6rem);
    font-weight: 300;
    line-height: 0.98;
    font-variation-settings: 'SOFT' 80, 'WONK' 1;
  }

  .loc {
    margin: 0.7rem 0 0;
    font-size: 1.25rem;
    font-style: italic;
    color: var(--tan);
  }

  .stock {
    margin: 0.9rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .stock.color {
    color: var(--film-edge-color);
  }

  .stock.bw {
    color: var(--film-edge-bw);
  }

  .about {
    margin-top: 1.8rem;
    max-width: 44rem;
  }

  .lede {
    margin: 0 0 0.8rem;
    font-size: clamp(1.15rem, 1rem + 0.6vw, 1.4rem);
    font-style: italic;
    color: var(--cream-dim);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 2rem;
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 1rem;
    align-items: center;
    margin-top: clamp(3rem, 8vw, 5rem);
  }

  .pager a {
    padding: 1rem 1.2rem;
    border: 1px solid var(--line-soft);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .pager a:hover {
    background: color-mix(in srgb, var(--olive) 45%, transparent);
  }

  .pager .center {
    text-align: center;
  }

  .pager .end {
    text-align: right;
  }

  @media (max-width: 640px) {
    .pager {
      grid-template-columns: 1fr;
    }

    .pager .end {
      text-align: left;
    }

    .pager span {
      display: none;
    }
  }
</style>
