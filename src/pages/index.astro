---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import SplitText from '../components/SplitText.astro';
import EssayRow from '../components/EssayRow.astro';
import { getSite } from '../lib/site';
import { getEssays } from '../lib/writing';
import { getAlbums } from '../lib/gallery';

const site = getSite();
const essays = (await getEssays()).slice(0, 3);
const albums = await getAlbums();
// A mix from every album: each album's cover, plus one more photo from
// partway through it, shuffled into a fixed order so neighbours vary.
const hash = (s: string) => [...s].reduce((h, c) => (h * 31 + c.charCodeAt(0)) >>> 0, 7);
const covers = albums.map((a) => ({ ...a.cover, albumTitle: a.title }));
const extras = albums
  .map((a) => {
    const rest = a.photos.filter((p) => p.file !== a.cover.file);
    const pick = rest[Math.floor(rest.length / 2)];
    return pick && { ...pick, albumTitle: a.title };
  })
  .filter((p) => !!p);
const shuffle = <T extends { album: string; file: string }>(list: T[]) =>
  list.map((p) => ({ p, k: hash(p.album + p.file) })).sort((a, b) => a.k - b.k).map((x) => x.p);
// Covers lead, then the extras; never two from the same album side by side.
const pool = [...shuffle(covers), ...shuffle(extras)];
const strip: typeof pool = [];
while (pool.length) {
  const i = pool.findIndex((p) => p.album !== strip.at(-1)?.album);
  strip.push(...pool.splice(i < 0 ? 0 : i, 1));
}

const [first, ...rest] = site.name.split(' ');
---

<Base>
  <section class="hero">
    <div class="aurora" aria-hidden="true"><span></span><span></span><span></span></div>
    <div class="wrap hero-inner">
      <p class="eyebrow" data-reveal="fade">{site.eyebrow}</p>
      <h1>
        <span class="l1"><SplitText text={first} /></span>
        {rest.length > 0 && <span class="l2"><SplitText text={rest.join(' ')} offset={first.length} /></span>}
      </h1>
      {site.headline && <p class="headline" data-reveal="blur" style="--i:6">{site.headline}</p>}
      <div class="hero-cta" data-reveal style="--i:8">
        <a class="btn btn--solid" href="/writing/">Read the writing</a>
        <a class="btn" href="/gallery/">See the photographs</a>
      </div>

    </div>
    <a href="#latest" class="scroll-cue" aria-label="Scroll down"><span></span></a>
  </section>

  {
    essays.length > 0 && (
      <section class="wrap latest" id="latest">
        <header class="sec-head" data-reveal>
          <p class="eyebrow">Latest writing</p>
          <a href="/writing/" class="all">All writing →</a>
        </header>
        <ol class="essays">
          {essays.map((e, i) => (
            <EssayRow essay={e} n={i + 1} i={i} />
          ))}
        </ol>
      </section>
    )
  }

  {
    strip.length > 0 && (
      <section class="photos">
        <header class="wrap sec-head" data-reveal>
          <p class="eyebrow">From the gallery</p>
          <a href="/gallery/" class="all">All albums →</a>
        </header>
        <div class="strip" data-reveal="fade">
          {strip.map((p, i) => (
            <a href={`/gallery/${p.album}/`} class="frame glow-card" style={`--i:${i}`}>
              <Image src={p.src} alt={p.caption ?? p.albumTitle} widths={[360, 720]} sizes="(max-width: 700px) 70vw, 340px" loading="lazy" />
              <span class="frame-cap">{p.albumTitle}</span>
            </a>
          ))}
        </div>
      </section>
    )
  }
</Base>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    margin-top: -4.5rem;
    padding-top: 4.5rem;
    display: grid;
    align-items: center;
    overflow: hidden;
  }

  .aurora {
    position: absolute;
    inset: 0;
    z-index: -1;
    filter: blur(80px);
    opacity: 0.75;
  }

  .aurora span {
    position: absolute;
    border-radius: 50%;
  }

  .aurora span:nth-child(1) {
    width: 46vw;
    height: 46vw;
    left: 62%;
    top: 4%;
    background: radial-gradient(circle, color-mix(in srgb, var(--shade) 13%, transparent), transparent 60%);
  }

  .aurora span:nth-child(2) {
    width: 38vw;
    height: 38vw;
    left: 70%;
    top: 40%;
    background: radial-gradient(circle, color-mix(in srgb, var(--accent) 10%, transparent), transparent 65%);
  }

  .aurora span:nth-child(3) {
    width: 34vw;
    height: 34vw;
    left: -8%;
    top: 55%;
    background: radial-gradient(circle, color-mix(in srgb, var(--panel) 45%, transparent), transparent 65%);
  }

  .hero-inner {
    position: relative;
    padding-block: 4rem 7rem;
  }

  h1 {
    margin-top: 1.4rem;
    font-size: clamp(3.6rem, 1rem + 12vw, 11.5rem);
    font-weight: 300;
    line-height: 0.88;
    letter-spacing: -0.035em;
    font-variation-settings: 'SOFT' 100, 'WONK' 0;
  }

  h1 > span {
    display: block;
  }

  .l2 {
    font-style: italic;
    color: var(--accent);
    padding-left: clamp(1.5rem, 9vw, 9rem);
    font-variation-settings: 'SOFT' 100, 'WONK' 1;
  }

  .headline {
    max-width: 34ch;
    margin: 2.4rem 0 0;
    font-size: clamp(1.2rem, 1rem + 0.8vw, 1.6rem);
    font-style: italic;
    color: var(--cream-dim);
    line-height: 1.45;
  }

  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 2.4rem;
  }

  .scroll-cue {
    position: absolute;
    left: 50%;
    bottom: 1.6rem;
    width: 1px;
    height: 3.5rem;
    overflow: hidden;
    background: var(--line-soft);
  }

  .scroll-cue span {
    position: absolute;
    inset: 0;
    background: var(--accent);
    animation: cue 2.4s var(--ease-in-out) infinite;
  }

  @keyframes cue {
    0% { transform: translateY(-100%); }
    60%, 100% { transform: translateY(100%); }
  }

  .sec-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 1.4rem;
  }

  .all {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--cream-dim);
  }

  .latest {
    margin-top: clamp(4rem, 9vw, 7rem);
  }

  .essays {
    margin: 0;
    padding: 0;
  }

  .photos {
    margin-top: clamp(4rem, 9vw, 7rem);
  }

  .strip {
    display: flex;
    gap: 1rem;
    overflow-x: auto;
    padding: 0.5rem var(--gutter) 1.5rem;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    scrollbar-width: thin;
    scrollbar-color: var(--accent-deep) transparent;
  }

  .frame {
    position: relative;
    flex: 0 0 auto;
    width: clamp(15rem, 26vw, 21rem);
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--radius);
    scroll-snap-align: start;
  }

  .frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.4s var(--ease-out), filter 0.8s;
    filter: saturate(0.85);
  }

  .frame:hover img {
    transform: scale(1.06);
    filter: saturate(1.05);
  }

  .frame-cap {
    position: absolute;
    inset: auto 0 0 0;
    padding: 2.5rem 1rem 0.9rem;
    background: linear-gradient(transparent, color-mix(in srgb, var(--bg) 85%, transparent));
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    transform: translateY(100%);
    transition: transform 0.6s var(--ease-out);
  }

  .frame:hover .frame-cap,
  .frame:focus-visible .frame-cap {
    transform: none;
  }

</style>

