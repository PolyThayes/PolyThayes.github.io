---
// The gallery as a film contact sheet: one frame per album.
import { Image } from 'astro:assets';
import type { Album } from '../lib/gallery';
import { frameLabel } from '../lib/gallery';

interface Props {
  albums: Album[];
}
const { albums } = Astro.props;

// Strips hold 6 frames on a wide screen (3 on tablets, 2 on phones).
// Unused spots at the end are left as blank, unexposed frames.
const PER_STRIP = 6;
const n = albums.length;
// How many blank frames each layout needs to finish its last strip.
const need = (cols: number) => Math.max(cols, Math.ceil(n / cols) * cols) - n;
const blanks = Array.from({ length: need(PER_STRIP) }, (_, k) => ({
  n: n + k,
  // hide this blank when the 3- or 2-across layout doesn't need it
  hide3: k >= need(3),
  hide2: k >= need(2),
}));

const STOCK = { color: 'PORTRA 400', bw: 'HP5+' } as const;

// A stable "random" choice per album so each favourite gets its own mark.
const hash = (s: string) => [...s].reduce((h, c) => (h * 31 + c.charCodeAt(0)) >>> 0, 7);
const marks = albums.map((a) => {
  const h = hash(a.slug);
  return { shape: h % 2 ? 'circle' : 'box', color: (h >> 3) % 2 ? 'red' : 'blue' };
});
---

<div class="sheet" data-reveal="fade">
  <ol class="frames" aria-label="Albums">
    {
      albums.map((a, i) => (
        <li class:list={['frame', a.mode, { fav: a.favorite }]} style={`--i:${i % PER_STRIP}`} data-reveal="fade">
          <a href={`/gallery/${a.slug}/`} class="frame-link">
            <span class="rebate top" aria-hidden="true">
              <span class="edge">{STOCK[a.mode]}</span>
              <span class="edge faint">{a.mode === 'bw' ? 'SAFETY FILM' : '◂ ' + (i + 1)}</span>
            </span>
            <span class="window">
              <Image
                src={a.cover.src}
                alt=""
                widths={[320, 520, 760]}
                sizes="(max-width: 560px) 46vw, (max-width: 900px) 31vw, 200px"
                loading={i < 6 ? 'eager' : 'lazy'}
              />
            </span>
            <span class="rebate bottom" aria-hidden="true">
              <span class="num">{a.frame}</span>
              <span class="title">{a.title}</span>
            </span>
            <span class="sr-only">
              Frame {a.frame}: {a.title}, {a.photos.length} photographs{a.mode === 'bw' ? ', black and white' : ', colour'}
              {a.favorite ? ', marked as a favourite' : ''}
            </span>
          </a>
          {a.favorite && (
            <svg class:list={['grease', marks[i].shape, marks[i].color]} viewBox="0 0 120 100" preserveAspectRatio="none" aria-hidden="true">
              {marks[i].shape === 'circle' ? (
                <>
                  <path pathLength="1" d="M64 7 C 97 5, 117 26, 115 52 C 113 81, 86 96, 57 95 C 25 94, 5 76, 6 49 C 8 22, 31 5, 70 10" />
                  <path class="second" pathLength="1" d="M70 10 C 92 13, 108 22, 112 34" />
                </>
              ) : (
                <>
                  <path pathLength="1" d="M7 13 L 113 8 L 115 91 L 9 94 L 5 18" />
                  <path class="second" pathLength="1" d="M4 10 L 26 9" />
                </>
              )}
            </svg>
          )}
        </li>
      ))
    }
    {
      blanks.map((b) => (
        <li class:list={['frame blank', { 'hide-3': b.hide3, 'hide-2': b.hide2 }]} aria-hidden="true">
          <span class="frame-link">
            <span class="rebate top">
              <span class="edge">HP5+</span>
            </span>
            <span class="window" />
            <span class="rebate bottom">
              <span class="num">{frameLabel(b.n)}</span>
            </span>
          </span>
        </li>
      ))
    }
  </ol>
</div>

<style>
  .sheet {
    --cols: 6;
    position: relative;
    padding: clamp(1rem, 3vw, 2.2rem) clamp(0.6rem, 2.5vw, 2rem);
    background:
      radial-gradient(120% 80% at 50% 0%, var(--film-base-2) 0%, transparent 70%),
      var(--film-base);
    border-radius: 2px;
    box-shadow:
      0 40px 90px -40px rgba(0, 0, 0, 0.9),
      inset 0 0 0 1px rgba(255, 255, 255, 0.03);
  }

  .frames {
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    row-gap: clamp(1.1rem, 2.6vw, 2rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .frame {
    --tint: var(--film-tint-bw);
    --edge: var(--film-edge-bw);
    position: relative;
  }

  .frame.color {
    --tint: var(--film-tint-color);
    --edge: var(--film-edge-color);
  }

  .frame-link {
    display: block;
    position: relative;
    background: var(--tint);
    text-decoration: none;
    color: var(--edge);
  }

  .frame-link:hover {
    text-shadow: none;
  }

  /* The film rebate: sprocket holes on the outer edge, edge print inside. */
  .rebate {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.6em;
    height: clamp(1.25rem, 2.2vw, 1.6rem);
    padding-inline: 0.5rem;
    font-family: var(--font-mono);
    font-size: clamp(0.5rem, 0.8vw, 0.6rem);
    letter-spacing: 0.14em;
    white-space: nowrap;
    overflow: hidden;
  }

  .rebate::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    height: 0.32rem;
    background: repeating-linear-gradient(
      90deg,
      transparent 0 0.38rem,
      color-mix(in srgb, var(--edge) 70%, white) 0.38rem 0.78rem
    );
    opacity: 0.75;
  }

  .rebate.top {
    padding-top: 0.45rem;
  }

  .rebate.top::before {
    top: 0.12rem;
  }

  .rebate.bottom {
    padding-bottom: 0.45rem;
  }

  .rebate.bottom::before {
    bottom: 0.12rem;
  }

  .edge {
    opacity: 0.85;
  }

  .edge.faint {
    margin-left: auto;
    opacity: 0.45;
  }

  .num {
    flex: none;
    font-weight: 500;
  }

  .title {
    overflow: hidden;
    text-overflow: ellipsis;
    color: var(--shade);
    opacity: 0.85;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .window {
    position: relative;
    display: block;
    aspect-ratio: 3 / 2;
    margin-inline: 3px;
    overflow: hidden;
    background: var(--film-window);
    transition: transform 0.45s var(--ease-out), box-shadow 0.5s var(--ease-out);
  }

  .window img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: filter 0.5s var(--ease-out);
  }

  /* Colour stock: slightly warm, like a colour-negative print. */
  .color .window img {
    filter: saturate(1.05) sepia(0.12) contrast(1.02);
  }

  /* B&W stock: neutral silver, a touch of contrast. */
  .bw .window img {
    filter: grayscale(1) contrast(1.06);
  }

  .frame-link:hover .window,
  .frame-link:focus-visible .window {
    transform: translateY(-4px);
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--gold) 45%, transparent),
      0 14px 34px -10px color-mix(in srgb, var(--gold) 45%, transparent);
    z-index: 2;
  }

  .frame-link:hover .window img {
    filter: none;
  }

  .blank .window {
    background:
      linear-gradient(160deg, rgba(255, 255, 255, 0.025), transparent 60%),
      var(--film-window);
  }

  .blank .frame-link {
    color: color-mix(in srgb, var(--film-edge-bw) 60%, transparent);
  }

  /* Grease-pencil marks for favourites */
  .grease {
    position: absolute;
    inset: -9% -6% -7%;
    width: 112%;
    height: 116%;
    z-index: 3;
    pointer-events: none;
    overflow: visible;
  }

  .grease path {
    fill: none;
    stroke-width: 3.2;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0.88;
  }

  .grease.red path {
    stroke: var(--grease-red);
  }

  .grease.blue path {
    stroke: var(--grease-blue);
  }

  .grease .second {
    stroke-width: 2.2;
    opacity: 0.7;
  }

  /* The mark is drawn on once the frame scrolls into view. */
  :global(.js) .grease path {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 1.1s var(--ease-in-out) 0.35s;
  }

  :global(.js) .grease .second {
    transition-delay: 1.2s;
    transition-duration: 0.4s;
  }

  :global(.js) .frame:global(.is-in) .grease path {
    stroke-dashoffset: 0;
  }

  @media (max-width: 900px) {
    .sheet {
      --cols: 3;
    }

    .hide-3 {
      display: none;
    }
  }

  @media (max-width: 560px) {
    .sheet {
      --cols: 2;
    }

    .hide-3 {
      display: block;
    }

    .hide-2 {
      display: none;
    }

    .rebate {
      font-size: 0.5rem;
    }
  }
</style>
