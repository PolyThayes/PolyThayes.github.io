---
import type { Essay } from '../lib/writing';
import { formatDate, toRoman } from '../lib/writing';
interface Props {
  essay: Essay;
  n: number;
  i?: number;
}
const { essay, n, i = 0 } = Astro.props;
---

<li class="essay" data-reveal style={`--i:${i}`}>
  <a href={`/writing/${essay.id}/`}>
    <span class="num">{toRoman(n)}.</span>
    <span class="body">
      <span class="meta">
        {essay.data.date && <time datetime={essay.data.date.toISOString()}>{formatDate(essay.data.date)}</time>}
        <span>{essay.minutes} min read</span>
      </span>
      <span class="title" transition:name={`essay-title-${essay.id}`}>{essay.title}</span>
      {essay.data.summary && <span class="summary">{essay.data.summary}</span>}
    </span>
    <span class="arrow" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M4 12h16M14 6l6 6-6 6" /></svg>
    </span>
  </a>
</li>

<style>
  .essay {
    list-style: none;
    border-top: 1px solid var(--line-soft);
  }

  .essay:last-child {
    border-bottom: 1px solid var(--line-soft);
  }

  a {
    position: relative;
    display: grid;
    grid-template-columns: 4.5rem 1fr 3rem;
    gap: 1.5rem;
    align-items: center;
    padding: clamp(1.6rem, 3.5vw, 2.6rem) 0.5rem;
    text-decoration: none;
    isolation: isolate;
  }

  a::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(90deg, rgba(142, 59, 59, 0.22), rgba(212, 173, 88, 0.07) 70%, transparent);
    transform: scaleY(0);
    transform-origin: bottom;
    transition: transform 0.7s var(--ease-out);
  }

  a:hover::before,
  a:focus-visible::before {
    transform: scaleY(1);
  }

  a:hover {
    color: inherit;
  }

  .num {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.4rem;
    color: var(--brass);
    text-align: right;
  }

  .body {
    display: grid;
    gap: 0.5rem;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.4rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .title {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1.1rem + 1.8vw, 2.6rem);
    font-weight: 350;
    line-height: 1.1;
    text-wrap: balance;
    transition: transform 0.7s var(--ease-out), color 0.4s;
  }

  a:hover .title {
    transform: translateX(0.6rem);
    color: var(--brass-hi);
  }

  .summary {
    font-style: italic;
    color: var(--ivory-dim);
    max-width: 60ch;
    transition: transform 0.7s var(--ease-out) 0.04s;
  }

  a:hover .summary {
    transform: translateX(0.6rem);
  }

  .arrow {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border: 1px solid var(--line);
    border-radius: 50%;
    color: var(--brass);
    transition: transform 0.6s var(--ease-out), background 0.4s, color 0.4s;
  }

  .arrow svg {
    width: 1.2rem;
  }

  a:hover .arrow {
    background: var(--brass);
    color: var(--ink);
    transform: rotate(-45deg);
  }

  @media (max-width: 640px) {
    a {
      grid-template-columns: 1fr;
      gap: 0.6rem;
      padding-inline: 0;
    }

    .num {
      text-align: left;
      font-size: 1.1rem;
    }

    .arrow {
      display: none;
    }
  }
</style>
