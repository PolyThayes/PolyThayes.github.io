---
import { Image } from 'astro:assets';
import type { Album } from '../lib/gallery';
import { formatDate } from '../lib/writing';
interface Props {
  album: Album;
  i: number;
}
const { album, i } = Astro.props;
const thumbs = album.photos.filter((p) => p !== album.cover).slice(0, 3);
---

<a class:list={['album', { flip: i % 2 === 1 }]} href={`/gallery/${album.slug}/`} data-reveal style={`--i:${i % 2}`}>
  <div class="cover">
    <div class="cover-img" transition:name={`album-cover-${album.slug}`}>
      <Image src={album.cover.src} alt="" widths={[600, 1000, 1500]} sizes="(max-width: 800px) 100vw, 60vw" loading={i < 2 ? 'eager' : 'lazy'} />
    </div>
    <div class="peek" aria-hidden="true">
      {thumbs.map((t, n) => <Image src={t.src} alt="" width={240} style={`--n:${n}`} loading="lazy" />)}
    </div>
  </div>
  <div class="info">
    <p class="eyebrow">
      {album.photos.length} photograph{album.photos.length === 1 ? '' : 's'}
      {album.date && <> · {formatDate(album.date, 'short')}</>}
    </p>
    <h2 transition:name={`album-title-${album.slug}`}>{album.title}</h2>
    {album.location && <p class="loc">{album.location}</p>}
    {album.description && <p class="desc">{album.description}</p>}
    <span class="open">Open album <span aria-hidden="true">→</span></span>
  </div>
</a>

<style>
  .album {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: center;
    text-decoration: none;
  }

  .album:hover {
    color: inherit;
  }

  .flip {
    grid-template-columns: 1fr 1.5fr;
  }

  .flip .cover {
    order: 2;
  }

  .cover {
    position: relative;
  }

  .cover-img {
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border-radius: var(--radius);
    box-shadow: 0 30px 80px -30px rgba(0, 0, 0, 0.8);
  }

  .cover-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.6s var(--ease-out), filter 1s;
    filter: saturate(0.9) brightness(0.92);
  }

  .album:hover .cover-img img {
    transform: scale(1.045);
    filter: saturate(1.05) brightness(1);
  }

  .peek {
    position: absolute;
    right: -1rem;
    bottom: -1.5rem;
    display: flex;
    pointer-events: none;
  }

  .flip .peek {
    right: auto;
    left: -1rem;
  }

  .peek img {
    width: clamp(4.5rem, 8vw, 7rem);
    aspect-ratio: 1;
    object-fit: cover;
    border: 3px solid var(--ink);
    border-radius: 3px;
    margin-left: -1.6rem;
    box-shadow: 0 12px 30px -8px rgba(0, 0, 0, 0.7);
    transform: translateY(1rem) rotate(calc((var(--n) - 1) * 6deg));
    opacity: 0;
    transition:
      transform 0.8s var(--ease-out),
      opacity 0.5s;
    transition-delay: calc(var(--n) * 70ms);
  }

  .album:hover .peek img {
    opacity: 1;
    transform: translateY(0) rotate(calc((var(--n) - 1) * 6deg));
  }

  .info h2 {
    margin-top: 0.8rem;
    font-size: clamp(2.2rem, 1.4rem + 3vw, 4.2rem);
    font-weight: 300;
    font-variation-settings: 'SOFT' 80, 'WONK' 1;
  }

  .loc {
    margin: 0.6rem 0 0;
    font-style: italic;
    color: var(--brass);
  }

  .desc {
    margin: 1rem 0 0;
    color: var(--ivory-dim);
    max-width: 36ch;
  }

  .open {
    display: inline-flex;
    gap: 0.6rem;
    margin-top: 1.6rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--brass);
  }

  .open span {
    transition: transform 0.5s var(--ease-out);
  }

  .album:hover .open span {
    transform: translateX(0.5rem);
  }

  @media (max-width: 800px) {
    .album,
    .flip {
      grid-template-columns: 1fr;
    }

    .flip .cover {
      order: 0;
    }

    .peek {
      display: none;
    }
  }
</style>
